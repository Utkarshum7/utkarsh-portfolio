---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Claim from '../components/content/Claim.astro';
import ExtLink from '../components/content/ExtLink.astro';
import CopyEmail from '../components/content/CopyEmail.astro';
import CertList from '../components/content/CertList.astro';
import Icon from '../components/site/Icon.astro';
import Dots from '../components/content/Dots.astro';
import ProjectShowcase from '../components/content/ProjectShowcase.astro';
import ActivityGraph from '../components/content/ActivityGraph.astro';
import RepoList from '../components/content/RepoList.astro';
import SkillsInventory from '../components/content/SkillsInventory.astro';
import { profile } from '../data/profile';
import { disciplines } from '../data/toolkit';
import { activity } from '../lib/activity';
import heroPortrait from '../assets/portrait/hero-portrait.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const flagships = projects.filter((p) => p.data.tier === 'flagship');
const [lead, ...pair] = flagships;
// Supporting projects with a live demo and a real screenshot
const tiles = await Promise.all(
  ['robofleet-monitor', 'appointment-board', 'apollo-family-clinic'].map((id) => getEntry('projects', id)),
);

// The three disciplines, each with a few representative tools (all evidenced on /skills)
const pillarTools: Record<string, string[]> = {
  backend: ['Python', 'Django', 'FastAPI', 'PostgreSQL'],
  ai: ['LLMs', 'Evaluation', 'Retrieval', 'Guardrails'],
  cloud: ['AWS', 'GCP', 'Docker', 'Kubernetes', 'Terraform'],
};

const site = new URL('/', Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: profile.name, url: site },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    url: site,
    jobTitle: 'Backend engineer',
    address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'RV College of Engineering' },
    sameAs: [profile.github, profile.linkedin],
    knowsAbout: [
      'Python',
      'Backend engineering',
      'AI systems',
      'LLM evaluation',
      'Cloud infrastructure',
      'DevOps',
      'Docker',
      'Kubernetes',
      'Terraform',
    ],
  },
];
---

<BaseLayout
  title="Utkarsh Amaresh · Backend engineer: AI systems, cloud & DevOps"
  description="Backend engineer working across Python services, AI systems and cloud & DevOps, where AI assists and deterministic code decides. Evidence you can check."
  jsonLd={jsonLd}
>
  <!-- 1. Identity: who, what, the statement, and the three disciplines -->
  <section class="hero container" aria-labelledby="hero-name">
    <div class="hero-copy">
      <p class="eyebrow">
        <Dots items={profile.roleLine.split(' · ')} />
      </p>
      <h1 id="hero-name">{profile.name}</h1>
      <p class="statement">{profile.statement}</p>
      <p class="lead">
        I built{' '}
        <a href="/work/scopetrace">
          <strong>ScopeTrace</strong>
        </a>
        , an emissions-reporting platform whose AI layer can explain the data but is designed, and tested per
        feature, never to change it, with <Claim id="st.tests.backend" /> running in CI; and{' '}
        <a href="/work/support-intelligence">a customer-support agent</a> I judged the hard way: against two
        baselines, on <Claim id="dsi.golden.human" />, with its weakest number in the headline.
      </p>
      <p class="status-line">
        <span>{profile.location}</span>
        <span>{profile.education}</span>
        <span>{profile.availability}</span>
      </p>
      <div class="actions">
        <a href="/work" class="button primary">
          See the work <Icon name="arrow-right" size={14} />
        </a>
        <a href="/code" class="button">
          Code &amp; activity
        </a>
        <CopyEmail />
      </div>
    </div>
    <figure class="hero-figure">
      <Image
        src={heroPortrait}
        alt="Utkarsh Amaresh at a conference"
        width={849}
        height={1061}
        widths={[420, 640, 849]}
        sizes="(min-width: 1024px) 26rem, (min-width: 900px) 30vw, calc(100vw - 3rem)"
        format="webp"
        quality={85}
        loading="lazy"
        decoding="async"
        class="hero-photo"
      />
    </figure>
    <!-- The disciplines as one system: a bus line with a node per discipline, and an occasional packet travelling
         along it (decorative; static under reduced motion) -->
    <div class="system">
      <div class="bus" aria-hidden="true">
        <span class="track">
          <span class="packet"></span>
        </span>
      </div>
      <ul role="list" class="pillars" aria-label="Disciplines">
        {disciplines.map((d) => (
          <li>
            <a href={`/skills#discipline-${d.id}`}>
              <span class="num">{d.index}</span>
              <span class="pillar-name">{d.title}</span>
              <span class="pillar-tools">
                <Dots items={pillarTools[d.id]!} />
              </span>
              <Icon name="arrow-right" size={14} class="pillar-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. What I build: visual, evidence-first -->
  <section class="section container" aria-labelledby="selected-work">
    <div class="section-head">
      <h2 class="section-label" id="selected-work">
        Selected work
      </h2>
      <a href="/work" class="all">
        All {projects.length} projects <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <div class="showcase-grid">
      <ProjectShowcase project={lead!} layout="lead" index={1} />
      <div class="pair">
        {pair.map((p, i) => (
          <ProjectShowcase project={p} layout="card" index={i + 2} />
        ))}
      </div>
    </div>
    <h3 class="sub">Also live</h3>
    <ul role="list" class="tiles">
      {tiles.map(
        (p) =>
          p && (
            <li>
              <ProjectShowcase project={p} layout="tile" headingLevel="h4" />
            </li>
          ),
      )}
    </ul>
  </section>

  <!-- 3. What I'm committing: a dated snapshot of public activity -->
  {activity && (
    <section class="section container" aria-labelledby="activity">
      <div class="section-head">
        <h2 class="section-label" id="activity">
          Build activity
        </h2>
        <a href="/code" class="all">
          Code <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <p class="total">
        <strong>{activity.total}</strong> commits across {activity.repos.length} public repositories in the
        last {activity.weeks} weeks
      </p>
      <ActivityGraph />
      <h3 class="sub">Recently committed to</h3>
      <RepoList recent={3} />
    </section>
  )}

  <!-- 4. What I use: compact inventory, evidence on demand -->
  <section class="section container" aria-labelledby="skills">
    <div class="section-head">
      <h2 class="section-label" id="skills">
        Skills
      </h2>
      <a href="/skills" class="all">
        Full inventory <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <p class="intro">Every tool links to where I used it: a project, the internship or a certification.</p>
    <SkillsInventory />
  </section>

  <!-- 5. Proof outside my own repositories: experience and credentials -->
  <section class="section container" aria-labelledby="experience">
    <h2 class="section-label" id="experience">
      Experience
    </h2>
    <div class="experience">
      <div class="job">
        <h3>DevOps Intern, Octakaigon Bock Private Limited</h3>
        <p class="when">Jun 2025 – May 2026</p>
        <p>
          <Claim id="job.role" marker={false}>
            Diagnosed and fixed production issues on AWS- and GCP-hosted backend APIs from their application,
            HTTP, network and system logs; deployed and maintained containerised services with Docker and
            Kubernetes, using Terraform and GitHub Actions for repeatable infrastructure and CI/CD; and wrote
            Python automation for recurring diagnostics, with Prometheus and Grafana for monitoring.
          </Claim>
        </p>
        <h3 class="edu">B.E., RV College of Engineering</h3>
        <p class="when">Bengaluru · Graduated 2026</p>
      </div>
      <div class="certs">
        <h3>Certifications</h3>
        <CertList />
      </div>
    </div>
    <p class="more">
      <a href="/about">
        More about me <Icon name="arrow-right" size={14} />
      </a>
    </p>
  </section>

  <!-- 6. Contact -->
  <section class="section container" aria-labelledby="contact">
    <h2 class="section-label" id="contact">
      Contact
    </h2>
    <p class="contact-line">
      I'm available immediately and happy to walk through any of this work in detail, including the parts that
      didn't work.
    </p>
    <ul role="list" class="contact">
      <li>
        <CopyEmail />
      </li>
      <li>
        <ExtLink href={profile.linkedin}>LinkedIn</ExtLink>
      </li>
      <li>
        <ExtLink href={profile.github}>GitHub</ExtLink>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero: copy left, portrait right from 900px; the three disciplines run across the bottom of the first screen */
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) clamp(15rem, 28vw, 24rem);
      align-items: center;
      column-gap: var(--space-8);
      row-gap: var(--space-8);
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-9) var(--space-9);
      column-gap: var(--space-10);
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero h1 {
    margin-top: var(--space-3);
    font-size: var(--text-name);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .statement {
    margin-top: var(--space-4);
    font-size: var(--text-hero);
    line-height: var(--lh-hero);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 30ch;
  }
  .lead {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: var(--ink-2);
    max-width: var(--measure-lead);
  }
  .lead strong {
    color: var(--ink);
  }
  .status-line {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  @media (min-width: 640px) {
    .status-line {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .status-line span + span::before {
      content: '·';
      margin-right: var(--space-4);
      color: var(--rule-strong);
    }
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding-inline: var(--space-4);
    border: var(--hairline) solid var(--rule-strong);
    border-radius: var(--radius-1);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      border-color: var(--ink-3);
      color: var(--ink);
    }
    .button.primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
      color: var(--on-accent);
    }
  }
  /* System bus: the disciplines' top rules form one line with a node at each, and a packet crosses it every ~11 s.
     Transform and opacity only; no JavaScript. Reduced motion: no packet, the line and nodes stay. */
  .system {
    grid-column: 1 / -1;
    position: relative;
  }
  .bus {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .track {
    position: absolute;
    inset: 0;
    animation: bus-travel 11s linear infinite;
    animation-delay: 1.5s;
    transform: translateX(calc(-100% - 4rem));
  }
  .packet {
    position: absolute;
    top: 0;
    left: 100%;
    width: 4rem;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--accent));
  }
  @keyframes bus-travel {
    0% {
      transform: translateX(calc(-100% - 4rem));
    }
    55%,
    100% {
      transform: translateX(4rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation-name: none;
      display: none;
    }
  }
  .pillars {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 768px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  /* A node on the bus at the start of each discipline */
  .pillars a::before {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--ink);
    background: var(--bg);
    z-index: 2;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .pillars a {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: var(--space-3) var(--space-6) var(--space-3) 0;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
  .pillar-name {
    font-size: var(--text-md);
    line-height: var(--lh-md);
    font-weight: 600;
  }
  .pillar-tools {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    color: var(--ink-3);
  }
  .pillars :global(.pillar-arrow) {
    position: absolute;
    right: 0;
    top: var(--space-4);
    color: var(--ink-3);
    transition: transform var(--dur-fast) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .pillars a:hover {
      border-top-color: var(--accent);
    }
    .pillars a:hover::before {
      border-color: var(--accent);
    }
    .pillars a:hover :global(.pillar-arrow) {
      color: var(--accent);
      transform: translateX(3px);
    }
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-head .section-label {
    margin-bottom: 0;
  }
  .all,
  .more a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    font-size: var(--text-sm);
  }
  .showcase-grid {
    display: grid;
    gap: var(--space-9);
  }
  .pair {
    display: grid;
    gap: var(--space-9);
  }
  @media (min-width: 900px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
  .sub {
    margin-top: var(--space-9);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 400;
  }
  .tiles {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .total {
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .total strong {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--ink);
    margin-right: var(--space-2);
  }
  /* Editorial treatment: grayscale, cool-tinted from the ink token, and faded into the page at its edges so the
     image reads as part of the page rather than as a card. */
  .hero-figure {
    position: relative;
    margin: 0;
    isolation: isolate;
    max-width: 28rem;
    -webkit-mask-image:
      linear-gradient(to top, transparent 0, black 26%), linear-gradient(to bottom, transparent 0, black 14%);
    mask-image:
      linear-gradient(to top, transparent 0, black 26%), linear-gradient(to bottom, transparent 0, black 14%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .hero-figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink-3);
    mix-blend-mode: color;
    opacity: 0.85;
    pointer-events: none;
  }
  .hero-figure :global(.hero-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 36%;
    filter: grayscale(1) contrast(1.05);
  }
  @media (min-width: 640px) {
    .hero-figure {
      max-width: none;
    }
    .hero-figure :global(.hero-photo) {
      aspect-ratio: 16 / 9;
      object-position: 50% 40%;
    }
  }
  @media (min-width: 900px) {
    .hero-figure {
      max-width: none;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0, black 42%),
        linear-gradient(to top, transparent 0, black 24%),
        linear-gradient(to bottom, transparent 0, black 10%);
      mask-image:
        linear-gradient(to right, transparent 0, black 42%),
        linear-gradient(to top, transparent 0, black 24%),
        linear-gradient(to bottom, transparent 0, black 10%);
    }
    .hero-figure :global(.hero-photo) {
      aspect-ratio: 4 / 5;
      object-position: 50% 50%;
    }
  }

  .experience {
    display: grid;
    gap: var(--space-7);
  }
  .experience h3 {
    font-size: var(--text-md);
    line-height: var(--lh-md);
  }
  .experience .edu {
    margin-top: var(--space-6);
  }
  .when {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .job p:not(.when) {
    margin-top: var(--space-3);
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .certs h3 {
    margin-bottom: var(--space-4);
  }
  @media (min-width: 1024px) {
    .experience {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-8);
    }
  }
  .more {
    margin-top: var(--space-5);
  }
  .intro {
    margin-bottom: var(--space-4);
  }
  .intro,
  .contact-line {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .contact {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
  }
  .contact :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
</style>
