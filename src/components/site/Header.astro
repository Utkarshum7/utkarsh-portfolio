---
import { profile } from '../../data/profile';
import Icon from './Icon.astro';
import { canonicalPath } from '../../lib/urls';

interface Props {
  sticky?: boolean;
}
const { sticky = false } = Astro.props;
const path = canonicalPath(Astro.url.pathname);
// Work = projects and case studies; Code = build activity and repositories; Skills = the evidence-backed toolkit
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/code', label: 'Code' },
  { href: '/skills', label: 'Skills' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class:list={['site-header', { sticky }]}>
  <div class="container bar">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="monogram" aria-hidden="true">
        UA
      </span>
      <span class="name">{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        {profile.resume && (
          <li>
            <a href={profile.resume} download>
              Résumé
            </a>
          </li>
        )}
      </ul>
    </nav>
    <div class="tools">
      <a class="icon-link" href={profile.github} aria-label="GitHub profile (external site)">
        <Icon name="github" size={18} />
      </a>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" hidden>
        <Icon name="moon" size={18} class="when-light" />
        <Icon name="sun" size={18} class="when-dark" />
      </button>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement: the toggle is hidden until this runs; without JS the system theme applies.
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const effective = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const label = () => {
    if (!button) return;
    const next = effective() === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
    button.dataset.current = effective();
  };
  if (button) {
    button.hidden = false;
    label();
    button.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: choice lasts for this page only */
      }
      label();
    });
  }
</script>

<style>
  .site-header {
    border-bottom: var(--hairline) solid var(--rule);
    background: var(--bg);
  }
  .site-header.sticky {
    position: sticky;
    top: 0;
    z-index: 10;
  }
  /* Phones: brand and tools on one row, the five sections on a second row that always fits */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'brand tools'
      'nav nav';
    align-items: center;
    column-gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .bar {
      min-height: var(--header-h);
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-areas: 'brand nav tools';
    }
  }
  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    justify-self: start;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .monogram {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: var(--hairline) solid var(--ink);
    border-radius: var(--radius-1);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .brand[aria-current='page'] .monogram {
    background: var(--ink);
    color: var(--bg);
  }
  .name {
    font-weight: 600;
    font-size: var(--text-sm);
  }
  nav {
    grid-area: nav;
    border-top: var(--hairline) solid var(--rule);
  }
  @media (min-width: 900px) {
    nav {
      border-top: 0;
    }
  }
  ul {
    display: flex;
    justify-content: space-between;
    margin: 0;
  }
  @media (min-width: 900px) {
    ul {
      justify-content: center;
      gap: var(--space-2);
    }
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-1);
    color: var(--ink-2);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease);
  }
  @media (min-width: 900px) {
    nav a {
      padding-inline: var(--space-3);
    }
  }
  nav a::after {
    content: '';
    position: absolute;
    left: var(--space-1);
    right: var(--space-1);
    bottom: 0;
    height: 2px;
    background: transparent;
    transition: background-color var(--dur-fast) var(--ease);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav a[aria-current='page']::after {
    background: var(--accent);
  }
  .tools {
    grid-area: tools;
    justify-self: end;
    display: flex;
    align-items: center;
  }
  .icon-link,
  .theme-toggle {
    width: var(--target);
    height: var(--target);
    display: inline-grid;
    place-items: center;
    background: transparent;
    border: 0;
    border-radius: var(--radius-1);
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle :global(.when-dark) {
    display: none;
  }
  .theme-toggle[data-current='dark'] :global(.when-dark) {
    display: block;
  }
  .theme-toggle[data-current='dark'] :global(.when-light) {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--ink);
    }
    nav a:hover::after {
      background: var(--rule-strong);
    }
    nav a[aria-current='page']:hover::after {
      background: var(--accent);
    }
    .icon-link:hover,
    .theme-toggle:hover {
      color: var(--ink);
    }
  }
</style>
