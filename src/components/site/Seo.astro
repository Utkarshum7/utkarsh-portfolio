---
import { canonicalPath } from '../../lib/urls';
/**
 * Page metadata: title, description, canonical, Open Graph, Twitter card, JSON-LD.
 * Only confirmed facts may appear here; they come from props built by the page from the claims registry.
 */
interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og/default.png',
  ogImageAlt = 'Utkarsh Amaresh: Backend engineer, Python and AI systems',
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const image = new URL(ogImage, Astro.site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Utkarsh Amaresh" />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content="Utkarsh Amaresh" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
{ld.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}
