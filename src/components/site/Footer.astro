---
import { profile } from '../../data/profile';

const built = new Date();
const builtLabel = built.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<footer class="site-footer">
  <div class="container inner">
    <p class="note">Every number on this site links to its source.</p>
    <ul role="list" class="links">
      <li>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </li>
      <li>
        <a href={profile.linkedin} rel="me">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={profile.github} rel="me">
          GitHub
        </a>
      </li>
    </ul>
    <p class="meta-line">
      <span>
        © {built.getUTCFullYear()} {profile.name}
      </span>
      <span>
        <a href="/colophon">Colophon</a>
      </span>
      <span>
        Last updated <time datetime={built.toISOString().slice(0, 10)}>{builtLabel}</time>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline) solid var(--rule);
    margin-top: var(--space-10);
    padding-block: var(--space-6) var(--space-8);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .inner {
    display: grid;
    gap: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  @media (min-width: 1024px) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .meta-line {
      grid-column: 1 / -1;
    }
  }
</style>
