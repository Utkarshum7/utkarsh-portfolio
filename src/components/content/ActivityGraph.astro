---
/**
 * Build activity: a calendar of public commits (owner, default branches, the repositories this site links).
 * Drawn like a contribution graph but labelled for what it is: a dated snapshot, not GitHub's own graph.
 * Pure HTML/CSS; the cells are decorative and the figure has a text summary.
 */
import { getEntry } from 'astro:content';
import { activity, fmtDay, PROJECT_BY_REPO } from '../../lib/activity';
import { profile } from '../../data/profile';
import ExtLink from './ExtLink.astro';

const a = activity!;
const DAY = 86_400_000;
const start = Date.parse(a.start + 'T00:00:00Z');
const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 9 ? 3 : 4);
const MOBILE_WEEKS = 26;
const cutoff = (a.weeks - MOBILE_WEEKS) * 7;

// A month label sits over the week that contains the 1st of that month
const months: { label: string; week: number }[] = [];
for (let w = 0; w < a.weeks; w++) {
  for (let d = 0; d < 7; d++) {
    const day = new Date(start + (w * 7 + d) * DAY);
    if (day.getUTCDate() === 1) {
      months.push({ label: day.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }), week: w });
    }
  }
}
const busiest = a.repos.reduce((m, r) => (r.commits > m.commits ? r : m), a.repos[0]!);
const busiestTitle = (await getEntry('projects', PROJECT_BY_REPO[busiest.key]!))?.data.title ?? busiest.key;
const reposWithCommits = a.repos.filter((r) => r.commits > 0).length;
const label = `Public commits by week and weekday, ${fmtDay(a.start)} to ${fmtDay(a.end)}: ${a.total} in total.`;
---

<figure class="activity">
  <div class="graph" role="img" aria-label={label}>
    <div class="months" aria-hidden="true">
      {months.map((m) => (
        <span
          class:list={{ early: m.week < a.weeks - MOBILE_WEEKS }}
          style={`--c:${m.week + 1};--cm:${m.week - (a.weeks - MOBILE_WEEKS) + 1}`}
        >
          {m.label}
        </span>
      ))}
    </div>
    <div class="weekdays" aria-hidden="true">
      <span style="--r:2">Mon</span>
      <span style="--r:4">Wed</span>
      <span style="--r:6">Fri</span>
    </div>
    <div class="cells" aria-hidden="true">
      {a.days.map((n, i) => (
        <i
          class:list={[`l${level(n)}`, { early: i < cutoff }]}
          title={
            n
              ? `${n} commit${n === 1 ? '' : 's'} · ${fmtDay(new Date(start + i * DAY).toISOString().slice(0, 10))}`
              : undefined
          }
        />
      ))}
    </div>
  </div>
  <figcaption>
    <span class="legend" aria-hidden="true">
      Less <i class="l0"></i>
      <i class="l1"></i>
      <i class="l2"></i>
      <i class="l3"></i>
      <i class="l4"></i> More
    </span>
    <span class="source">
      Snapshot taken {fmtDay(a.generatedAt.slice(0, 10))}, not live. Counts my commits on the default branch
      of the {a.repos.length} public repositories this site links ({reposWithCommits} with commits in this
      period); private and unlisted work isn't included. Most active: {busiestTitle}.{' '}
      <ExtLink href={profile.github}>GitHub profile</ExtLink>
    </span>
  </figcaption>
</figure>

<style>
  .activity {
    margin: 0;
    container-type: inline-size;
  }
  .graph {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
  }
  .months,
  .cells {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    column-gap: 3px;
  }
  .months {
    grid-row: 1;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-3);
    line-height: 1;
  }
  .months span {
    grid-column: var(--c) / span 4;
    white-space: nowrap;
  }
  .weekdays {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-rows: repeat(7, minmax(0, 1fr));
    row-gap: 3px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-3);
    line-height: 1;
  }
  .weekdays span {
    grid-row: var(--r);
    align-self: center;
  }
  .cells {
    grid-row: 2;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: 3px;
  }
  i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--sunken);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .l1 {
    background: color-mix(in srgb, var(--accent) 30%, var(--surface));
    box-shadow: none;
  }
  .l2 {
    background: color-mix(in srgb, var(--accent) 55%, var(--surface));
    box-shadow: none;
  }
  .l3 {
    background: color-mix(in srgb, var(--accent) 78%, var(--surface));
    box-shadow: none;
  }
  .l4 {
    background: var(--accent);
    box-shadow: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .cells i[title]:hover {
      outline: 2px solid var(--ink);
      outline-offset: 1px;
    }
  }
  /* Phones: the last 26 weeks, so each cell stays large enough to read */
  @container (max-width: 34rem) {
    .months,
    .cells {
      grid-template-columns: repeat(26, minmax(0, 1fr));
    }
    .cells .early,
    .months .early {
      display: none;
    }
    .months span {
      grid-column: var(--cm) / span 4;
    }
  }
  figcaption {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    color: var(--ink-3);
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    justify-self: end;
    font-family: var(--font-mono);
  }
  .legend i {
    width: 0.625rem;
  }
  .source {
    max-width: var(--measure);
  }
</style>
