---
/** The disciplines a project demonstrates, as a quiet mono line (text, never colour alone). */
import { AREAS, type AreaId } from '../../data/toolkit';

interface Props {
  areas: AreaId[];
}
const { areas } = Astro.props;
---

<ul role="list" class="areas" aria-label="Disciplines">
  {areas.map((a) => (
    <li>{AREAS[a].label}</li>
  ))}
</ul>

<style>
  .areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
    flex: none;
  }
</style>
